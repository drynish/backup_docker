{
	email michel.dicroci@gmail.com

	order crowdsec first

	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_API_KEY}
		ticker_interval 15s
	}

	servers {
		trusted_proxies cloudflare
	}
}

(crowdsec_protect) {
	log {
		output file /data/logs/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
	crowdsec
}

(local_or_authelia) {
	@local client_ip 192.168.90.0/24 192.168.130.0/24
	handle @local {
		reverse_proxy {args[0]}
	}
	handle {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.drynish.synology.me
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy {args[0]}
	}
	respond 403
}

(local_only) {
	@local client_ip 192.168.90.0/24 192.168.130.0/24
	handle @local {
		reverse_proxy {args[0]}
	}
	respond 403
}

# ─── dicroci.website ─────────────────────────────────────────────────────────

auth.dicroci.website {
	import crowdsec_protect
	reverse_proxy authelia:9091
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

doc.dicroci.website {
	import crowdsec_protect
	@local {
		client_ip 192.168.90.0/24 192.168.130.0/24 10.88.88.2/32 70.55.121.27/32 69.157.173.254/32 24.50.90.220/32
	}

	handle @local {
		reverse_proxy wikijs:3000
	}

	handle {
		forward_auth http://authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy wikijs:3000
	}

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

plex.dicroci.website {
    import crowdsec_protect

    redir / /web/index.html

    reverse_proxy http://10.88.88.2:32400 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Plex-Client-Identifier {remote_host}
        transport http {
            versions 1.1
            read_timeout 0
            write_timeout 0
        }
        health_uri /identity
        health_interval 5s
        health_timeout 2s
        fail_duration 10s
    }

    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
}

