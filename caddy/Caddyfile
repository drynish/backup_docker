wol.drynish.synology.me {
        import crowdsec_protect
        @local client_ip 192.168.90.0/24 192.168.200.0/24 192.168.130.0/24 10.88.88.0/24

        handle @local {
                @rootPath path /
                redir @rootPath /api/wakeup/computer/Windows
                reverse_proxy 192.168.90.3:4000
        }

        handle {
                forward_auth authelia:9091 {
                        uri /api/verify?rd=https://auth.drynish.synology.me
                        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
                }
                @rootPath path /
                redir @rootPath /api/wakeup/computer/Windows
                reverse_proxy 192.168.90.3:4000
        }
}

